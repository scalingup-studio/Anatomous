<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Health Summary Report" %></title>
  <style>
    /* === Anatomous Design System - Dark Theme === */
    :root {
      /* Primary Brand Colors */
      --anatomous-primary: #00BACE;
      --anatomous-secondary: #004CD7;
      --anatomous-accent: #00A3B5;

      /* Base UI Colors */
      --anatomous-bg: #000000;
      --anatomous-surface: #111111;
      --anatomous-divider: #222222;

      /* Text & Icon Colors */
      --anatomous-text-primary: #FFFFFF;
      --anatomous-text-secondary: #CCCCCC;
      --anatomous-text-disabled: #777777;

      /* Semantic Colors */
      --status-positive: #00C37A;
      --status-warning: #F5A623;
      --status-negative: #FF4C4C;
      --status-info: #5BC0DE;

      /* Legacy support */
      --anatomous-dark: #FFFFFF;
      --anatomous-gray: #CCCCCC;
      --anatomous-light: #111111;
      --anatomous-white: #000000;
      --anatomous-border: #222222;

      --font-primary: 'Inter', 'Manrope', 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-primary);
      font-weight: 400;
      background: var(--anatomous-bg);
      color: var(--anatomous-text-primary);
      line-height: 1.4;
      counter-reset: page;
      font-size: 12px;
    }

    /* === Оптимізована структура сторінок === */
    .page {
      min-height: 29.7cm;
      padding: 0.4in 0.5in 0.6in 0.5in;
      position: relative;
      page-break-after: always;
      page-break-inside: avoid;
      counter-increment: page;
      background: var(--anatomous-bg);
    }

    /* === Номер сторінки === */
    .page::after {
      content: "Page " counter(page);
      position: absolute;
      bottom: 0.25in;
      right: 0.5in;
      font-size: 0.65rem;
      color: var(--anatomous-text-disabled);
      z-index: 10;
    }

    /* === Обкладинка === */
    .cover-page {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: 29.7cm;
      background: linear-gradient(135deg, var(--anatomous-bg) 0%, var(--anatomous-surface) 100%);
      page-break-after: avoid;
    }

    .cover-page::after {
      content: none;
    }

    /* === Заголовки === */
    .logo {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: var(--anatomous-primary);
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .report-title {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--anatomous-secondary);
    }

    .user-name {
      font-size: 1.25rem;
      margin-bottom: 0.4rem;
      color: var(--anatomous-text-primary);
    }

    .date-range {
      font-size: 0.95rem;
      color: var(--anatomous-text-secondary);
      margin-bottom: 1.5rem;
    }

    .section-title {
      color: var(--anatomous-secondary);
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--anatomous-primary);
      page-break-after: avoid;
    }

    .subsection-title {
      color: var(--anatomous-primary);
      font-size: 0.95rem;
      font-weight: 600;
      margin: 0.75rem 0 0.5rem 0;
      padding-bottom: 0.3rem;
      border-bottom: 1px solid var(--anatomous-primary);
      page-break-after: avoid;
    }

    /* === Секції === */
    .section {
      margin-bottom: 1.25rem;
      page-break-inside: avoid;
    }

    .section:last-child {
      margin-bottom: 0;
    }

    /* === Контент === */
    .overview-text {
      background: var(--anatomous-surface);
      padding: 1rem;
      border-radius: 6px;
      border-left: 3px solid var(--anatomous-primary);
      line-height: 1.5;
      margin-bottom: 1.25rem;
      font-size: 0.85rem;
      color: var(--anatomous-text-secondary);
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      page-break-inside: avoid;
    }

    .metric-card {
      background: var(--anatomous-surface);
      border: 1px solid var(--anatomous-divider);
      border-radius: 6px;
      padding: 0.85rem;
      text-align: center;
      transition: border-color 0.2s;
    }

    .metric-card:hover {
      border-color: var(--anatomous-primary);
    }

    .metric-value {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--anatomous-primary);
      margin-bottom: 0.4rem;
    }

    .metric-label {
      font-size: 0.7rem;
      color: var(--anatomous-text-disabled);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .chart-container {
      background: var(--anatomous-surface);
      border: 1px solid var(--anatomous-divider);
      border-radius: 6px;
      padding: 1.25rem;
      margin: 1.25rem 0;
      page-break-inside: avoid;
    }

    .trend-stats {
      display: flex;
      justify-content: space-around;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .trend-stat {
      text-align: center;
      min-width: 100px;
    }

    .trend-value {
      font-size: 1rem;
      font-weight: 700;
      color: var(--anatomous-primary);
      margin-bottom: 0.3rem;
    }

    .trend-label {
      font-size: 0.65rem;
      color: var(--anatomous-text-disabled);
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .metric-change {
      font-size: 0.7rem;
      padding: 3px 10px;
      border-radius: 20px;
      font-weight: 600;
    }

    .change-positive {
      background: rgba(0, 195, 122, 0.15);
      color: var(--status-positive);
    }

    .change-negative {
      background: rgba(255, 76, 76, 0.15);
      color: var(--status-negative);
    }

    .no-data {
      text-align: center;
      color: var(--anatomous-text-disabled);
      padding: 1.5rem 1rem;
      font-style: italic;
      font-size: 0.85rem;
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin: 1.25rem 0;
      page-break-inside: avoid;
    }

    .comparison-card {
      background: var(--anatomous-surface);
      padding: 1.25rem;
      border-radius: 6px;
      border-left: 3px solid var(--anatomous-secondary);
    }

    .comparison-card h4 {
      color: var(--anatomous-primary);
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    .comparison-metric {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 0.6rem 0;
      padding: 0.6rem;
      background: var(--anatomous-bg);
      border-radius: 4px;
      font-size: 0.8rem;
    }

    .comparison-metric .metric-label {
      color: var(--anatomous-text-secondary);
      text-transform: capitalize;
    }

    .comparison-value {
      font-weight: 600;
      color: var(--anatomous-text-primary);
      margin-right: 0.5rem;
    }

    .comparison-change {
      font-size: 0.7rem;
      padding: 3px 10px;
      border-radius: 15px;
      font-weight: 600;
    }

    .goals-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--anatomous-surface);
      margin-bottom: 1rem;
      page-break-inside: auto;
      font-size: 0.8rem;
    }

    .goals-table thead {
      page-break-after: avoid;
    }

    .goals-table th,
    .goals-table td {
      padding: 0.7rem;
      text-align: left;
      border-bottom: 1px solid var(--anatomous-divider);
    }

    .goals-table th {
      background: var(--anatomous-bg);
      color: var(--anatomous-primary);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 0.5px;
    }

    .goals-table td {
      color: var(--anatomous-text-secondary);
    }

    .goals-table td strong {
      color: var(--anatomous-text-primary);
    }

    .status-badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      white-space: nowrap;
      letter-spacing: 0.3px;
    }

    .status-on-track {
      background: rgba(0, 195, 122, 0.15);
      color: var(--status-positive);
    }

    .status-completed {
      background: rgba(0, 76, 215, 0.15);
      color: var(--anatomous-secondary);
    }

    .status-paused {
      background: rgba(245, 166, 35, 0.15);
      color: var(--status-warning);
    }

    .alerts-container {
      margin: 1.25rem 0;
    }

    .alert-item {
      display: flex;
      align-items: center;
      padding: 0.85rem;
      margin: 0.6rem 0;
      border-radius: 6px;
      border-left: 3px solid;
      background: var(--anatomous-surface);
      page-break-inside: avoid;
    }

    .alert-item.high {
      border-left-color: var(--status-negative);
      background: rgba(255, 76, 76, 0.1);
    }

    .alert-item.medium {
      border-left-color: var(--status-warning);
      background: rgba(245, 166, 35, 0.1);
    }

    .alert-item.low {
      border-left-color: var(--anatomous-secondary);
      background: rgba(0, 76, 215, 0.1);
    }

    .alert-severity {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.65rem;
      font-weight: 700;
      margin-right: 0.85rem;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .alert-item.high .alert-severity {
      background: var(--status-negative);
      color: var(--anatomous-bg);
    }

    .alert-item.medium .alert-severity {
      background: var(--status-warning);
      color: var(--anatomous-bg);
    }

    .alert-item.low .alert-severity {
      background: var(--anatomous-secondary);
      color: var(--anatomous-text-primary);
    }

    .alert-message {
      flex: 1;
      font-size: 0.8rem;
      color: var(--anatomous-text-secondary);
    }

    .journal-entry {
      background: var(--anatomous-surface);
      padding: 1rem;
      margin: 0.85rem 0;
      border-radius: 6px;
      border-left: 3px solid var(--anatomous-primary);
      page-break-inside: avoid;
    }

    .journal-date {
      font-weight: 600;
      color: var(--anatomous-primary);
      margin-bottom: 0.4rem;
      font-size: 0.8rem;
    }

    .journal-content {
      line-height: 1.5;
      margin-bottom: 0.6rem;
      color: var(--anatomous-text-secondary);
      font-size: 0.85rem;
    }

    .recommendations-grid {
      display: grid;
      gap: 1.25rem;
      margin: 1.25rem 0;
    }

    .recommendation-category {
      background: var(--anatomous-surface);
      padding: 1.25rem;
      border-radius: 6px;
      border-left: 3px solid var(--anatomous-primary);
      page-break-inside: avoid;
    }

    .recommendation-category h3 {
      color: var(--anatomous-primary);
      font-size: 0.95rem;
      margin-bottom: 0.85rem;
    }

    .recommendation-list {
      list-style: none;
      margin: 0.85rem 0 0 0;
    }

    .recommendation-list li {
      margin: 0.6rem 0;
      padding: 0.6rem 0.85rem;
      background: var(--anatomous-bg);
      border-radius: 4px;
      border-left: 2px solid var(--anatomous-secondary);
      line-height: 1.4;
      font-size: 0.8rem;
      color: var(--anatomous-text-secondary);
    }

    .recommendation-list li small {
      color: var(--anatomous-text-disabled);
      font-size: 0.7rem;
    }

    .disclaimer-text {
      background: var(--anatomous-surface);
      padding: 1.25rem;
      border-radius: 6px;
      border: 1px solid var(--anatomous-divider);
      line-height: 1.6;
      font-size: 0.8rem;
      color: var(--anatomous-text-secondary);
    }

    .disclaimer-text p {
      margin-bottom: 0.85rem;
    }

    .disclaimer-text p:last-child {
      margin-bottom: 0;
    }

    .disclaimer-text strong {
      color: var(--anatomous-text-primary);
    }

    .footer {
      text-align: center;
      font-size: 0.65rem;
      color: var(--anatomous-text-disabled);
      margin-top: 1.5rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--anatomous-divider);
    }

    .tagline {
      font-style: italic;
      color: var(--anatomous-primary);
    }

    .toc-list {
      list-style: decimal;
      margin-left: 2rem;
      line-height: 1.8;
    }

    .toc-list li {
      margin: 0.6rem 0;
      padding-left: 0.4rem;
    }

    .toc-list a {
      color: var(--anatomous-primary);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }

    .toc-list a:hover {
      color: var(--anatomous-secondary);
      text-decoration: underline;
    }

    .progress-summary {
      background: var(--anatomous-surface);
      padding: 1.25rem;
      border-radius: 6px;
      margin: 1.25rem 0;
      border-left: 3px solid var(--anatomous-secondary);
      page-break-inside: avoid;
    }

    /* === Progress Bars === */
    .progress-container {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .progress-bar-background {
      flex-grow: 1;
      background: var(--anatomous-divider);
      border-radius: 10px;
      height: 6px;
      overflow: hidden;
    }

    .progress-bar-fill {
      background: linear-gradient(90deg, var(--anatomous-primary), var(--anatomous-secondary));
      height: 100%;
      border-radius: 10px;
      transition: width 0.3s ease;
    }

    .progress-value {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--anatomous-primary);
      min-width: 35px;
    }

    .progress-details {
      font-size: 0.65rem;
      color: var(--anatomous-text-disabled);
      margin-top: 3px;
    }

    .progress-bar-full {
      background: var(--anatomous-divider);
      border-radius: 10px;
      height: 10px;
      overflow: hidden;
    }

    .progress-bar-gradient {
      background: linear-gradient(90deg, var(--anatomous-primary), var(--anatomous-secondary));
      height: 100%;
      border-radius: 10px;
      transition: width 0.3s ease;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
      font-size: 0.7rem;
      color: var(--anatomous-text-disabled);
    }

    .progress-percentage {
      font-weight: 600;
      color: var(--anatomous-primary);
    }

    .entry-value {
      font-weight: 600;
      color: var(--anatomous-primary);
    }

    .entry-date {
      color: var(--anatomous-text-disabled);
    }

    /* === Chart Styles === */
    .chart-wrapper {
      background: var(--anatomous-bg);
      border: 1px solid var(--anatomous-divider);
      border-radius: 4px;
      padding: 15px;
      height: 120px;
      position: relative;
    }

    .chart-svg {
      width: 100%;
      height: 100%;
    }

    .chart-grid line {
      stroke: var(--anatomous-divider);
      stroke-width: 1;
    }

    .chart-line {
      stroke: var(--anatomous-primary);
      stroke-width: 2;
      fill: none;
    }

    .chart-area {
      fill: rgba(0, 186, 206, 0.1);
    }

    .chart-point {
      fill: var(--anatomous-secondary);
      stroke: var(--anatomous-bg);
      stroke-width: 1.5;
    }

    .chart-axis {
      font-size: 8px;
      color: var(--anatomous-text-disabled);
    }

    .notes-section {
      background: var(--anatomous-surface);
      padding: 15px;
      border-radius: 6px;
      border-left: 4px solid var(--anatomous-primary);
      margin-top: 15px;
    }

    .note-item {
      margin-bottom: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--anatomous-divider);
    }

    .note-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
    }

    .note-title {
      font-weight: 600;
      color: var(--anatomous-primary);
      font-size: 0.9rem;
      margin-bottom: 4px;
    }

    .note-content {
      font-size: 0.8rem;
      color: var(--anatomous-text-secondary);
      line-height: 1.4;
    }

    /* === Print оптимізація === */
    @media print {
      body {
        background: white;
        color: black;
      }

      .page {
        page-break-after: always;
        page-break-inside: avoid;
        background: white;
      }

      .section,
      .metric-card,
      .chart-container,
      .comparison-card,
      .alert-item,
      .journal-entry,
      .recommendation-category {
        page-break-inside: avoid;
      }

      .section-title,
      .subsection-title {
        page-break-after: avoid;
      }

      /* Print dark theme colors */
      :root {
        --anatomous-bg: #ffffff;
        --anatomous-surface: #f5f5f5;
        --anatomous-text-primary: #000000;
        --anatomous-text-secondary: #333333;
        --anatomous-divider: #e0e0e0;
      }
    }
  </style>
</head>
<body>
  <!-- Cover Page -->
  <div class="page cover-page">
    <div class="logo"><img alt="Anatomous" src="../images/logo-anatomous.png"></div>
    <h1 class="report-title">Health Summary Report</h1>
    <div class="user-name"><%= user?.first_name || "" %> <%= user?.last_name || "" %></div>
    <div class="date-range">
      <% if (date_range === 'all') { %>
        All time
      <% } else { %>
        Last <%= date_range %> days
      <% } %>
    </div>
  </div>

  <!-- Content Page -->
  <div class="page">
    <!-- Overview Section -->
    <div class="section">
      <h2 class="section-title">Overview</h2>
      <div class="overview-text">
        <% 
          const firstInsight = insights && insights.length > 0 ? insights[0] : null;
          if (firstInsight && firstInsight.description) {
            const insightText = firstInsight.description;
            const cleanText = insightText.replace(/\*\*(.*?)\*\*/g, '$1').replace(/\*/g, '');
            const maxLength = 300;
            const displayText = cleanText.length > maxLength ?
              cleanText.substring(0, maxLength) + '...' : cleanText;
        %>
          <%= displayText %>
        <% } else { %>
          This health summary provides a concise overview of your key biometric data and trends. Monitor your progress and discuss any significant changes with your healthcare provider.
        <% } %>
      </div>
    </div>

    <!-- Key Metrics Snapshot -->
    <div class="section">
      <h2 class="section-title">Key Metrics Snapshot</h2>
      <% 
        const validVitals = vitals && vitals.filter(v =>
          v.heart_rate > 0 || v.blood_pressure_systolic > 0 || v.pulse_oximetry > 0 ||
          v.weekly_activity_minutes > 0 || v.hydration_liters > 0
        );
        const latestValid = validVitals && validVitals.length > 0 ?
          validVitals[validVitals.length - 1] : null;
      %>
      <% if (latestValid) { %>
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-value">
            <%= latestValid.heart_rate > 0 ? latestValid.heart_rate : '--' %> bpm
          </div>
          <div class="metric-label">Heart Rate</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">
            <%= latestValid.blood_pressure_systolic > 0 ? latestValid.blood_pressure_systolic : '--' %>/
            <%= latestValid.blood_pressure_diastolic > 0 ? latestValid.blood_pressure_diastolic : '--' %>
          </div>
          <div class="metric-label">Blood Pressure</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">
            <%= latestValid.pulse_oximetry > 0 ? latestValid.pulse_oximetry : '--' %>%
          </div>
          <div class="metric-label">SpO₂</div>
        </div>
        <div class="metric-card">
          <div class="metric-value"><%= user?.weight_kg || '--' %> kg</div>
          <div class="metric-label">Weight</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">
            <%= latestValid.weekly_activity_minutes > 0 ? latestValid.weekly_activity_minutes : '--' %> min
          </div>
          <div class="metric-label">Weekly Activity</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">
            <%= latestValid.hydration_liters > 0 ? latestValid.hydration_liters : '--' %> L
          </div>
          <div class="metric-label">Hydration</div>
        </div>
      </div>
      <% } else { %>
        <div class="no-data">No recent metric data available</div>
      <% } %>
    </div>

    <!-- Heart Rate Trend Section -->
    <div class="section">
      <h2 class="section-title">Heart Rate Trend</h2>
      <div class="chart-container">
        <% 
          const heartRateData = vitals_trend && vitals_trend.data ? vitals_trend.data.heart_rate : null;
          const trendData = heartRateData && heartRateData.trend ? heartRateData.trend : [];
          const summary = heartRateData && heartRateData.summary ? heartRateData.summary : {};
          const validTrendData = trendData.filter(item => item.value > 0);
          let currentValue = summary.last_value;
          let averageValue = summary.avg;
          let changeValue = summary.change;

          if (!currentValue && validTrendData.length > 0) {
            currentValue = validTrendData[validTrendData.length - 1].value;
          }
          if (!averageValue && validTrendData.length > 0) {
            const sum = validTrendData.reduce((acc, item) => acc + item.value, 0);
            averageValue = sum / validTrendData.length;
          }
        %>
        <% if (validTrendData.length > 0) { %>
          <div class="trend-stats">
            <div class="trend-stat">
              <div class="trend-value"><%= currentValue || '--' %> bpm</div>
              <div class="trend-label">Current</div>
            </div>
            <div class="trend-stat">
              <div class="trend-value"><%= averageValue ? averageValue.toFixed(1) : '--' %> bpm</div>
              <div class="trend-label">Average</div>
            </div>
            <div class="trend-stat">
              <div class="trend-value">
                <% if (changeValue !== undefined) { %>
                  <span class="metric-change <%= changeValue >= 0 ? 'change-negative' : 'change-positive' %>">
                    <%= changeValue >= 0 ? '+' : '' %><%= changeValue %>%
                  </span>
                <% } else { %>
                  --
                <% } %>
              </div>
              <div class="trend-label">Change</div>
            </div>
          </div>
          <div class="chart-wrapper">
            <svg class="chart-svg" viewBox="0 0 500 120" preserveAspectRatio="none">
              <% 
                const values = validTrendData.map(d => d.value);
                if (values.length > 0) {
                  const maxValue = Math.max(...values);
                  const minValue = Math.min(...values);
                  const range = maxValue - minValue || 1;
                  const padding = range * 0.1;
                  const chartWidth = 480;
                  const chartHeight = 80;
                  const xStep = chartWidth / (values.length - 1);
              %>
              <path class="chart-area" d="
                M 10,<%= 10 + chartHeight - ((values[0] - minValue + padding) / (range + padding * 2)) * chartHeight %>
                <% values.forEach((value, index) => { %>
                  L <%= 10 + index * xStep %>,<%= 10 + chartHeight - ((value - minValue + padding) / (range + padding * 2)) * chartHeight %>
                <% }); %>
                L <%= 10 + chartWidth %>,<%= 10 + chartHeight %>
                L 10,<%= 10 + chartHeight %>
                Z
              " />
              <path class="chart-line" d="
                M 10,<%= 10 + chartHeight - ((values[0] - minValue + padding) / (range + padding * 2)) * chartHeight %>
                <% values.forEach((value, index) => { %>
                  L <%= 10 + index * xStep %>,<%= 10 + chartHeight - ((value - minValue + padding) / (range + padding * 2)) * chartHeight %>
                <% }); %>
              " />
              <% values.forEach((value, index) => { %>
                <circle
                  class="chart-point"
                  cx="<%= 10 + index * xStep %>"
                  cy="<%= 10 + chartHeight - ((value - minValue + padding) / (range + padding * 2)) * chartHeight %>"
                  r="1.5"
                />
              <% }); %>
              <% } else { %>
                <text x="250" y="60" class="chart-axis" text-anchor="middle">No chart data available</text>
              <% } %>
            </svg>
          </div>
        <% } else { %>
          <div class="no-data">
            No heart rate trend data available
            <div style="font-size: 0.7rem; margin-top: 8px;">
              Heart rate trend visualization over time
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Goals Section -->
    <% 
      const activeGoals = goals && goals.filter(goal =>
        goal.status && goal.status !== 'archived' && goal.title && goal.title.trim().length > 0
      );
    %>
    <% if (activeGoals && activeGoals.length > 0) { %>
    <div class="section">
      <h2 class="section-title">Recent Goals</h2>
      <div class="notes-section">
        <% activeGoals.slice(0, 2).forEach(goal => { %>
          <div class="note-item">
            <div class="note-title"><%= goal.title %></div>
            <div class="note-content">
              <%= goal.description || 'No description' %>
              <% if (goal.target_date) { %>
                <br><small>Target: <%= new Date(goal.target_date).toLocaleDateString() %></small>
              <% } %>
              <% if (goal.status) { %>
                <br><small>Status: <%= goal.status %></small>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="footer">
      Report generated on <%= new Date().toLocaleDateString() %>
      <div class="tagline">Autonomy over Anatomy</div>
    </div>
  </div>
</body>
</html>
